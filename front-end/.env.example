# URL API backend (kèm hậu tố /api/v1). KHÔNG có dấu "/" ở cuối.
# Local:  http://localhost:5000/api/v1
# Prod:   https://<backend-domain>/api/v1
VITE_BASE_URL=http://localhost:5000/api/v1

# Origin của backend cho kết nối Socket.IO (KHÔNG kèm /api/v1).
# Local:  http://localhost:5000
# Prod:   https://<backend-domain>
VITE_REACT_PUBLIC_SOCKET_URL=http://localhost:5000

# Cloudinary (upload ảnh)
VITE_CLOUD_NAME=your_cloudinary_cloud_name
VITE_UPLOAD_PRESET=your_cloudinary_upload_preset

# Firebase (OTP) — lấy từ Firebase Console > Project settings
VITE_REACT_PUBLIC_FIREBASE_API_KEY=
VITE_REACT_PUBLIC_FIREBASE_AUTH_DOMAIN=
VITE_REACT_PUBLIC_FIREBASE_PROJECT_ID=
VITE_REACT_PUBLIC_FIREBASE_STORAGE_BUCKET=
VITE_REACT_PUBLIC_FIREBASE_MESSAGE_SENDER_ID=
VITE_REACT_PUBLIC_FIREBASE_APP_ID=
VITE_REACT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Gemini (chatbot). CẢNH BÁO: key này bị lộ ra client.
# Bắt buộc giới hạn key theo HTTP referrer + quota trong Google Cloud Console.
VITE_API_MODEL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=YOUR_GEMINI_API_KEY
